# ─── CipherGate Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in the values.
# On Vercel, configure these in the Project Dashboard → Settings → Environment Variables.
#
# REQUIRED
# ────────
VITE_NETWORK_ID=preprod
# The Midnight network to connect to. Valid values: preprod, preview, undeployed.
# This determines the indexer, RPC, and faucet endpoints used by the application.

# OPTIONAL
# ────────
VITE_LOGGING_LEVEL=info
# Pino logging level. Valid values: trace, debug, info, warn, error, fatal.
# Set to 'silent' in production to disable all logging.

# ─── Deployment Only (Not used by Vite, needed for contract deployment) ──────
# These are set at Vercel build time or in your deployment environment.
PROOF_SERVER_URL=http://127.0.0.1:6300
# URL of the Midnight proof server. Required for contract deployment.
# For local development: http://127.0.0.1:6300
# For production: Set to your proof server endpoint.

WALLET_SEED=
# Wallet seed for contract deployment. If not set, a random seed is generated.
# The seed printed at deployment time must be saved for subsequent operations.

PRIVATE_STATE_PASSWORD=
# Password for the level-db private state store.
# If not set, a default is used (not recommended for production).
